# ============================================================
# Supabase Configuration (SaaS 기반)
# https://supabase.com/dashboard에서 프로젝트 생성 후 발급
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 카카오 JavaScript 키 (https://developers.kakao.com에서 발급)
NEXT_PUBLIC_KAKAO_JS_KEY=your_kakao_javascript_key_here

# 사이트 URL (Vercel 배포 후 실제 URL로 변경)
NEXT_PUBLIC_SITE_URL=https://your-wedding-invitation.vercel.app

# 로컬 동기화
# Development 환경을 그대로 받고 싶으면:
# npm run env:pull
# 실제 비밀값이 들어가는 .env.local은 Git에 커밋하지 마세요.

# Firebase Configuration (방명록 기능용)
# https://console.firebase.google.com에서 프로젝트 생성 후 발급
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Guestbook Master Password (방명록 관리자 비밀번호)
NEXT_PUBLIC_GUESTBOOK_MASTER_PASSWORD=your_master_password

# Guest Snap Discord Webhook (optional)
GUEST_SNAP_DISCORD_WEBHOOK_URL=

# Google Drive auth mode
# auto | oauth | service_account
GOOGLE_DRIVE_AUTH_MODE=auto

# Guest Snap Google Drive Configuration (서버 전용)
# 권장(개인 My Drive): OAuth 사용자 토큰 방식
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=

# 권장(배포/Vercel, Shared Drive 전제): 서비스 계정 JSON Base64
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64=
# 권장(로컬): 서비스 계정 JSON 파일 경로
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/to/guestsnap-service-account.json
# 대안: JSON 문자열 직접 저장
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# 레거시 대안(호환용)
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_root_folder_id
# Optional: Shared Drive 사용 시 설정
GOOGLE_DRIVE_SHARED_DRIVE_ID=
