# ================================================
# Google Drive Configuration for Guest Snap
# ================================================
# 이 파일을 복사하여 .env.local 파일을 생성하세요
# cp .env.local.example .env.local
# 그런 다음 실제 값으로 수정하세요
# ================================================

# Guest Snap Discord Webhook (선택)
GUEST_SNAP_DISCORD_WEBHOOK_URL=

# 권장(개인 My Drive): OAuth 사용자 토큰 방식
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=

# 권장(Shared Drive): 서비스 계정 JSON 파일 경로
# 예: /Users/you/secure/guestsnap-service-account.json
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_PATH=

# 대안: 서비스 계정 JSON 문자열을 환경변수에 직접 저장
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# 레거시 대안(호환용): client email + private key 분리 입력
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=

# Guest Snap 업로드 루트 폴더 ID (필수)
# 예: Google Drive 폴더 URL이
# https://drive.google.com/drive/folders/1AbCdEfGhIjK... 인 경우
# GOOGLE_DRIVE_ROOT_FOLDER_ID=1AbCdEfGhIjK...
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_root_folder_id

# Shared Drive를 사용하는 경우에만 설정 (선택)
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# ================================================
# 설정 팁
# ================================================
# 0) 서비스 계정 JSON 파일은 Git에 절대 커밋하지 마세요.
# 1) 개인 My Drive면 OAuth 3종(CLIENT_ID/SECRET/REFRESH_TOKEN) 설정을 우선 사용하세요.
# 2) 서비스 계정 방식은 Shared Drive에서 가장 안정적입니다.
# 3) 서비스 계정 방식일 때는 루트 폴더를 서비스 계정 이메일에 "편집자" 권한으로 공유하세요.
